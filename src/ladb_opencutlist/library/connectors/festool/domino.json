{
  "format": "ocl-hardware",
  "version": 1,
  "id": "f439655f-5cfd-4615-b193-8a23db1ad4ba",
  "type": "connector",
  "name": "Domino",
  "abstract": true,
  "supplier": "Festool",
  "url": "https://www.festool.com",
  "variables": {
    "width": { "label": "Width" },
    "length": { "label": "Length" },
    "mortise_slot": { "value": "13mm", "label": "Mortise Slot", "step": [ "13mm", "19mm", "23mm" ]},
    "mortise_length": "@width + @mortise_slot",
    "min_wall": { "value": "5mm", "label": "Minimum wall" },
    "cap_a": "floor(min(@thickness_a - @min_wall; @length / 2); 12mm; 15mm; 20mm; 25mm; 28mm)",
    "cap_b": "floor(min(@thickness_b - @min_wall; @length / 2); 12mm; 15mm; 20mm; 25mm; 28mm)",
    "depth_a": "min(floor(@thickness_a - @min_wall; 12mm; 15mm; 20mm; 25mm; 28mm); ceil(@length - @cap_b; 12mm; 15mm; 20mm; 25mm; 28mm))",
    "depth_b": "min(floor(@thickness_b - @min_wall; 12mm; 15mm; 20mm; 25mm; 28mm); ceil(@length - @cap_a; 12mm; 15mm; 20mm; 25mm; 28mm))"
  },
  "asserts": [ "@depth_a + @depth_b >= @length" ],
  "components": {
    "a": {
      "hardware": { "oblongs": [ { "length": "@mortise_length", "width": "@width", "from": "-(@length + @depth_a - @depth_b) / 2", "to": "(@length - @depth_a + @depth_b) / 2" } ] },
      "machining": { "mortises": [ { "length": "@mortise_length", "width": "@width", "depth": "@depth_a" } ] },
      "attributes": { "symmetrical":  true }
    },
    "b": { "machining": { "mortises": [ { "length": "@mortise_length", "width": "@width", "depth": "@depth_b" } ] } }
  },
  "options": { "height": "/2", "start_offset": "37mm", "end_offset": "37mm", "max_spacing": "500mm" }
}
