{
  "format": "ocl-hardware",
  "version": 1,
  "id": "9c3ac804-6281-4bcf-8bbf-89ea0992f2da",
  "type": "connector",
  "name": "Screw 4x50",
  "variables": {
    "embed": "50mm - @thickness_max_a"
  },
  "asserts": [ "@thickness_max_a - @thickness_min_a <= 0.2mm", "@embed >= 15mm", "@embed <= @thickness_b - 3mm" ],
  "components": {
    "a": {
      "hardware": { "cylinders": [ { "diameter": "4mm", "from": "-@thickness_max_a", "to": "@embed", "countersink": { "diameter": "8mm", "angle": 90, "end": "from" } } ] },
      "machining": { "drillings": [ { "diameter": "4mm", "depth": "through" } ] },
      "attributes": { "symmetrical":  true }
    },
    "b": { "machining": { "drillings": [ { "diameter": "2.5mm", "depth": "@embed" } ] } }
  },
  "options": { "height": "/2", "start_offset": "50mm", "end_offset": "50mm", "max_spacing": "300mm" }
}
