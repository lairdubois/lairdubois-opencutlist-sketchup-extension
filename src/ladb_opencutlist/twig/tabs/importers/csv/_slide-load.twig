{% extends 'tabs/base-slide.twig' %}

{% set id = 'ladb_importers_csv_slide_load' %}

{% block headerInner %}
    {{ parent() }}
    <ul class="ladb-file-tabs nav nav-tabs no-print">
        {% embed 'tabs/base-file-tab.twig' %}
            {% block inner %}{{ parent() }}<span class="ladb-extra ladb-horizontal-left-separator">{{ importablePartCount }} {{ ('default.part_'~(importablePartCount > 1 ? 'plural' : 'single'))|i18next }}</span>{% include 'core/_length-unit-extra.twig' %}{% endblock %}
        {% endembed %}
    </ul>
{% endblock %}

{% block headerHeadingInner %}
    {{ 'tab.importers.csv.title'|i18next}}
{% endblock %}

{% block headerToolsInner %}
    <button id="ladb_btn_import" class="btn btn-primary"><i class="ladb-opencutlist-icon-plus"></i><span class="hidden-xs"> {{ 'tab.importers.default.import_to_model'|i18next }}...</span></button>
    &nbsp;
    <button class="btn btn-default" data-help-page="importers.csv"><i class="ladb-opencutlist-icon-help"></i></button>
    &nbsp;
    <button id="ladb_btn_close" class="btn btn-default"><i class="ladb-opencutlist-icon-close"></i><span class="hidden-xs"> {{ 'default.close'|i18next }}</span></button>
{% endblock %}

{% block containerInner %}
    {{ parent() }}
    <div class="ladb-page ladb-importers-page">

        {% include 'core/_alert-errors.twig' %}
        {% include 'core/_alert-warnings.twig' %}

        {% if parts|length > 0 %}
            <table class="table table-bordered">
                <thead>
                <tr>
                    <td></td>
                    {% for column in columns %}
                        <td class="ladb-importers-column{% if column.mapping %} ladb-importers-column-mapped{% endif %}">
                            <div>
                                <select id="ladb_select_column_{{ loop.index0 }}" class="form-control" data-column="{{ loop.index0 }}">
                                    <option data-content="<span style='color: #ccc; font-style: italic;'>{{ 'tab.importers.csv.column.unused'|i18next }}</span>"></option>
                                    <optgroup label="{{ 'tab.importers.csv.column.mandatory'|i18next }}">
                                        <option value="name">{{ 'tab.importers.csv.column.name'|i18next }}</option>
                                        <option value="length">{{ 'tab.importers.csv.column.bbox_length'|i18next }}</option>
                                        <option value="width">{{ 'tab.importers.csv.column.bbox_width'|i18next }}</option>
                                        <option value="thickness">{{ 'tab.importers.csv.column.bbox_thickness'|i18next }}</option>
                                    </optgroup>
                                    <optgroup label="{{ 'tab.importers.csv.column.optional'|i18next }}">
                                        <option value="count">{{ 'tab.importers.csv.column.count'|i18next }}</option>
                                        <option value="material">{{ 'tab.importers.csv.column.material'|i18next }}</option>
                                        <option value="tags">{{ 'tab.importers.csv.column.tags'|i18next }}</option>
                                    </optgroup>
                                </select>
                            </div>
                            {% if column.header %}
                                <div class="ladb-importers-header">{{ column.header }}</div>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% for part in parts if loop.index > 0 %}
                    {% set hasErrors = not part.errors is empty %}
                    {% set hasWarnings = not part.warnings is empty %}
                    <tr class="ladb-importers-row{% if hasErrors %} ladb-importers-row-error{% else %} ladb-importers-row-success{% endif %}">
                        <td>
                            {% if hasErrors %}
                                <i class="ladb-opencutlist-icon-warning ladb-color-danger" data-toggle="tooltip" data-html="true" title="<div style='text-align: left;'>{{ 'tab.importers.csv.tooltip.errors'|i18next }} :<ul>{% for error in part.errors %}<li>{{ error|i18next }}</li>{% endfor %}</ul></div>"></i>
                            {% elseif hasWarnings %}
                                <i class="ladb-opencutlist-icon-tick ladb-color-warning" data-toggle="tooltip" data-html="true" title="<div style='text-align: left;'>{{ 'tab.importers.csv.tooltip.warnings'|i18next }} :<ul>{% for warning in part.warnings %}<li>{{ warning|i18next }}</li>{% endfor %}</ul></div>"></i>
                            {% else %}
                                <i class="ladb-opencutlist-icon-tick ladb-color-success"></i>
                            {% endif %}
                        </td>
                        {% for raw_value in part.raw_values %}
                            {% set column = columns[loop.index0] %}
                            <td  class="ladb-importers-column ladb-importers-column-{% if column and column.mapping is null %}not-mapped{% else %}mapped{% endif %} text-{{ column.align }}{% if column and column.mapping and not raw_value.valid %} ladb-invalid-value{% endif %}">{{ raw_value.value }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

    </div>
{% endblock %}