{% extends 'core/_modal.twig' %}

{% set id = 'ladb_importer_modal_import' %}
{% set title = 'tab.importers.bxf2.import.title'|i18next %}

{% block headerToolsInner %}
    {% include 'components/_widget-preset.twig' %}
    <button class="btn btn-default btn-xs" data-help-page="importer.import"><i class="ladb-opencutlist-icon-help"></i> {{ 'default.help'|i18next }}</button>
{% endblock %}

{% block bodyInner %}
    <div class="row">
        <div class="col-xs-push-1 col-xs-10">{{ 'tab.importers.bxf2.import.info_0'|i18next({ 'count':cabinetCount }) }}</div>
        <div class="col-xs-push-1 col-xs-10">{{ 'tab.importers.bxf2.import.info_1'|i18next }}</div>
    </div>
    <hr>
    <div class="form row">
        <div class="form-group">
            <label class="control-label col-xs-offset-1 col-xs-11">{{ 'tab.importers.bxf2.import.option_parts_formula'|i18next }} <small style="font-weight: normal;">(Ruby)</small></label>
            <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_parts_formula_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
            <div class="col-xs-offset-1 col-xs-10">
                <textarea id="ladb_importer_import_textarea_parts_formula" class="form-control" placeholder="{{ 'tab.importers.bxf2.import.formula.part'|i18next }}"></textarea>
            </div>
        </div>
    </div>
    <hr>
    <div class="form form-horizontal">
        <section>
            <h4>{{ 'tab.importers.bxf2.import.materials'|i18next }}</h4>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_part_wood_material_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_no_material_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_part_wood_material_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_part_wood_material_name">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_part_aluminium_material_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_no_material_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_part_aluminium_material_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_part_aluminium_material_name">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_part_glass_material_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_no_material_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_part_glass_material_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_part_glass_material_name">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_machining_material_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_default_material_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_machining_material_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_machining_material_name">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_hardware_material_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_default_material_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_hardware_material_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_hardware_material_name">
                </div>
            </div>
        </section>
        <section>
            <h4>{{ 'tab.importers.bxf2.import.layers'|i18next }}</h4>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_front_part_layer_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_no_layer_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_front_part_layer_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_front_part_layer_name">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_machining_layer_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_no_layer_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_machining_layer_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_machining_layer_name">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tab.importers.bxf2.import.option_hardware_layer_name_help'|i18next }}<br><br>{{ 'tab.importers.bxf2.import.option_no_layer_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-3">{{ 'tab.importers.bxf2.import.option_hardware_layer_name'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_importer_import_input_hardware_layer_name">
                </div>
            </div>
        </section>
    </div>
    <p class="help-block text-center">{{ 'tab.importers.bxf2.import.info_2'|i18next }}</p>
{% endblock %}

{% block footerRightInner %}
    <button class="btn btn-default" data-dismiss="modal">{{ 'default.cancel'|i18next }}</button>
    <button class="btn btn-primary" id="ladb_importer_import">{{ 'default.import'|i18next }}</button>
{% endblock %}
