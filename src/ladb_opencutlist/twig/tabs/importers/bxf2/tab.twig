{% extends 'tabs/base-tab.twig' %}

{% block headerToolsInner %}
    <button id="ladb_btn_open" class="btn btn-primary">{{ 'tab.importers.default.open_file'|i18next({ 'extension':'BXF2' }) }}...</button>
    &nbsp;
    <button class="btn btn-default" data-help-page="importer"><i class="ladb-opencutlist-icon-help"></i></button>
{% endblock %}

{% block containerInner %}
    {% embed 'core/_panel-help.twig' %}
        {% block bodyInner %}
            <p>{{ 'tab.importers.bxf2.help'|i18next }}</p>
        {% endblock %}
    {% endembed %}
    {{ parent() }}
    <div class="ladb-page ladb-importers-page"></div>
{% endblock %}