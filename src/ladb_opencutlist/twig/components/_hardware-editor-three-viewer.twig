{% extends 'components/_three-viewer.twig' %}

{% import 'components/_three-viewer.twig' as fn %}

{% block uiLeft %}
    {{ fn.btn_view('isometric', 'view-isometric', THREE_CAMERA_VIEWS) }}
    {{ fn.btn_view('top', 'arrow-down', THREE_CAMERA_VIEWS) }}
    <div class="ladb-flex">
        {{ fn.btn_view('left', 'arrow-right', THREE_CAMERA_VIEWS, null, 'left') }}
        {{ fn.btn_view('front', 'view-front', THREE_CAMERA_VIEWS, null, 'top') }}
        {{ fn.btn_view('right', 'arrow-left', THREE_CAMERA_VIEWS) }}
    </div>
    {{ fn.btn_view('bottom', 'arrow-up', THREE_CAMERA_VIEWS) }}
    {{ fn.btn_view('back', 'view-back', THREE_CAMERA_VIEWS) }}
    <span>&nbsp;</span>
    {{ fn.btn_zoom(null, '<i class="ladb-opencutlist-icon-zoom-auto"></i>', 'core.hardware_editor.zoom_auto'|i18next) }}
{% endblock %}

{% block uiRight %}
    {{ fn.btn_command('axes', 'set_axes_helper_visible', { visible:null }, 'core.component.three_viewer.toggle_axes_helper'|i18next, 'left') }}
    {% for slot in [ 'a', 'b' ] %}
        <button class="btn btn-default btn-sm" data-command="set_bench_slot_visible" data-params="{{ { slot:slot, visible:null }|json_encode|escape('html') }}" data-toggle="tooltip" data-placement="left" title="{{ 'core.hardware_editor.toggle_slot'|i18next({ 'slot':slot|upper }) }}">{{ slot|upper }}</button>
    {% endfor %}
{% endblock %}
