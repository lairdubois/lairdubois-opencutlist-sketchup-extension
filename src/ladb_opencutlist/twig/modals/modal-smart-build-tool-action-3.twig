{% extends 'modals/modal-smart-build-tool-action.twig' %}

{% block optionOptionsReduceEnvelope %}
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_options_reduce_envelope_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_options_reduce_envelope'|i18next }}</label>
        <div class="col-xs-7">
            <select class="form-control" id="ladb_select_reduce_envelope">
                <option value="0" data-content="{{ 'default.no'|i18next }}"></option>
                <option value="1" data-content="{{ 'tool.smart_build.action_option_options_reduce_envelope_status'|i18next }}"></option>
            </select>
        </div>
    </div>
{% endblock %}

{% block formInner %}
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_thickness_thickness_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_group_thickness'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_thickness">
        </div>
    </div>
    <hr>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_groove_groove_depth_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_groove_groove_depth'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_groove_depth">
        </div>
    </div>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_groove_groove_setback_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_groove_groove_setback'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_groove_setback">
        </div>
    </div>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_groove_groove_through_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_groove_groove_through'|i18next }}</label>
        <div class="col-xs-7">
            <select class="form-control" id="ladb_select_groove_through">
                <option value="0" data-content="{{ 'default.no'|i18next }}"></option>
                <option value="1" data-content="{{ 'default.yes'|i18next }}"></option>
            </select>
        </div>
    </div>
    <hr>
    <div class="form-group">
        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_group_axes'|i18next }}</label>
        <div class="col-xs-7">
            <select class="form-control" id="ladb_select_axes">
                <option value="active" data-content="{{ 'tool.smart_build.action_option_axes_active_status'|i18next }}"></option>
                <option value="context" data-content="{{ 'tool.smart_build.action_option_axes_context_status'|i18next }}"></option>
            </select>
        </div>
    </div>
    {{ parent() }}
    <hr>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_options_layer_name_status'|i18next }}<br><br>{{ 'tool.smart_build.action_option_no_layer_help'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_options_layer_name'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_layer_name">
        </div>
    </div>
{% endblock %}
