{% extends 'core/_modal.twig' %}

{% set id = 'ladb_modal_'~modalName %}
{% set title = ('tool.smart_join.action_'~action)|i18next %}

{% block headerToolsInner %}
    {% include 'components/_widget-preset.twig' %}
    <button class="btn btn-default btn-xs" data-help-page="tool.smart-draw"><i class="ladb-opencutlist-icon-help"></i> {{ 'default.help'|i18next }}</button>
{% endblock %}

{% block bodyInner %}
    <div class="tab-content">
        <div class="form form-horizontal" style="margin-top: 15px;">
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_anchors_start_offset_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_anchors_start_offset'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_input_start_offset">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_anchors_start_offset_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_anchors_end_offset'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_input_end_offset">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_anchors_min_spacing_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_anchors_min_spacing'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_input_min_spacing">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_anchors_max_spacing_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_anchors_max_spacing'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_input_max_spacing">
                </div>
            </div>
            <hr>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_anchors_depth_distance_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_anchors_depth_distance'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_input_depth_distance">
                </div>
            </div>
            <hr>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_hardware_a_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_hardware_a'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_input_hardware_a">
