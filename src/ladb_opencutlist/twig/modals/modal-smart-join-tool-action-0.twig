            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_machining_material_name_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
