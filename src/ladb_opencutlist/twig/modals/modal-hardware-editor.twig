{% extends 'core/_modal.twig' %}

{% set id = 'ladb_modal_'~modalName %}
{% set title = 'core.hardware_editor.title'|i18next~' <small class="ladb-hardware-editor-name"></small>' %}
{% set bodyClasses = 'ladb-hardware-editor' %}

{% block bodyInner %}
    <div class="ladb-hardware-editor-bench">
        <div class="ladb-hardware-editor-viewer">
            <div class="ladb-hardware-editor-verdict" style="display: none;"></div>
            <div class="ladb-hardware-editor-trial">
                <div class="ladb-hardware-editor-bench-settings" style="display: none;">
                    <div class="ladb-hardware-editor-bench-settings-title">{{ 'core.hardware_editor.bench_settings'|i18next }}</div>
                    <div class="ladb-hardware-editor-bench-setting" data-slot="a">
                        <label for="ladb_hardware_editor_input_thickness_a"><span class="ladb-hardware-editor-slot-pin ladb-hardware-editor-slot-pin-a">A</span> {{ 'core.hardware_editor.thickness_a'|i18next }}</label>
                        <input type="text" class="form-control input-sm" id="ladb_hardware_editor_input_thickness_a">
                    </div>
                    <div class="ladb-hardware-editor-bench-setting" data-slot="b">
                        <label for="ladb_hardware_editor_input_thickness_b"><span class="ladb-hardware-editor-slot-pin ladb-hardware-editor-slot-pin-b">B</span> {{ 'core.hardware_editor.thickness_b'|i18next }}</label>
                        <input type="text" class="form-control input-sm" id="ladb_hardware_editor_input_thickness_b">
                    </div>
                </div>
                <div class="btn-group btn-group-sm ladb-hardware-editor-topologies" role="group"></div>
                <button type="button" class="btn btn-default btn-sm" id="ladb_hardware_editor_btn_swap" style="display: none;" data-toggle="tooltip" title="{{ 'core.hardware_editor.swap'|i18next }}"><i class="ladb-opencutlist-icon-swap"></i></button>
                <button type="button" class="btn btn-default btn-sm" id="ladb_hardware_editor_btn_bench_settings" data-toggle="tooltip" title="{{ 'core.hardware_editor.bench_settings'|i18next }}"><i class="ladb-opencutlist-icon-settings"></i></button>
            </div>
        </div>
        <div class="ladb-hardware-editor-unsupported" style="display: none;"></div>
        <div class="ladb-hardware-editor-computations"></div>
    </div>
    <div class="ladb-hardware-editor-editor">
        <div class="ladb-hardware-editor-readonly alert alert-info" style="display: none;">
            {{ 'core.hardware_editor.readonly_notice'|i18next }}
        </div>
        <div class="ladb-hardware-editor-abstract alert alert-warning" style="display: none;">
            {{ 'core.hardware_editor.abstract_notice'|i18next }}
        </div>
        <div class="ladb-hardware-editor-file-bar ladb-hardware-editor-name-bar form-inline">
            <label for="ladb_hardware_editor_input_name">{{ 'core.hardware_editor.name'|i18next }}</label>
            <input type="text" class="form-control input-sm" id="ladb_hardware_editor_input_name">
        </div>
        <div class="ladb-hardware-editor-file-bar form-inline">
            <label for="ladb_hardware_editor_input_file">{{ 'core.hardware_editor.file'|i18next }}</label>
            <span class="ladb-hardware-editor-file-dir"></span>
            <input type="text" class="form-control input-sm" id="ladb_hardware_editor_input_file" spellcheck="false">
            <span class="ladb-hardware-editor-file-ext">.json</span>
        </div>
        <div class="ladb-hardware-editor-file-extends" style="display: none;"><span data-toggle="tooltip"></span></div>
        <div class="ladb-hardware-editor-file-renamed text-muted" style="display: none;"></div>
        <ul class="nav nav-tabs nav-justified" role="tablist">
            <li role="presentation" class="active"><a href="#ladb_hardware_editor_tab_settings" role="tab" data-toggle="tab"><i class="ladb-opencutlist-icon-settings"></i> {{ 'core.hardware_editor.tab_settings'|i18next }}</a></li>
            <li role="presentation"><a href="#ladb_hardware_editor_tab_parts" role="tab" data-toggle="tab"><i class="ladb-opencutlist-icon-plan"></i> {{ 'core.hardware_editor.tab_parts'|i18next }}</a></li>
            <li role="presentation"><a href="#ladb_hardware_editor_tab_json" role="tab" data-toggle="tab"><i class="ladb-opencutlist-icon-snippets"></i> {{ 'core.hardware_editor.tab_json'|i18next }} <span class="label label-danger ladb-hardware-editor-error-count" style="display: none;"></span></a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="ladb_hardware_editor_tab_settings">
                <div class="ladb-hardware-editor-settings form form-horizontal"></div>
            </div>
            <div role="tabpanel" class="tab-pane" id="ladb_hardware_editor_tab_parts">
                <div class="ladb-hardware-editor-parts"></div>
            </div>
            <div role="tabpanel" class="tab-pane" id="ladb_hardware_editor_tab_json">
                <div class="ladb-hardware-editor-json">
                    <textarea id="ladb_hardware_editor_input_json"></textarea>
                </div>
                <div class="ladb-hardware-editor-errors"></div>
            </div>
        </div>
    </div>
    <div class="ladb-hardware-editor-shaping-panel">
        <p class="ladb-hardware-editor-shaping-name"></p>
        <p class="text-muted">{{ 'core.hardware_editor.shaping_help'|i18next }}</p>
        <div class="ladb-hardware-editor-shaping-buttons">
            <button class="btn btn-default" id="ladb_hardware_editor_btn_shaping_cancel">{{ 'default.cancel'|i18next }}</button>
            <button class="btn btn-primary" id="ladb_hardware_editor_btn_shaping_finish">{{ 'default.finish'|i18next }}</button>
        </div>
    </div>
{% endblock %}

{% block footerLeftInner %}
    <button class="btn btn-danger" id="ladb_hardware_editor_btn_delete" style="display: none;">{{ 'default.delete'|i18next }}</button>
    <span class="ladb-hardware-editor-status"></span>
{% endblock %}

{% block footerRightInner %}
    <button class="btn btn-default" data-dismiss="modal">{{ 'default.cancel'|i18next }}</button>
    <button class="btn btn-default" id="ladb_hardware_editor_btn_derive" style="display: none;" title="{{ 'core.hardware_editor.derive_help'|i18next }}">{{ 'core.hardware_editor.derive'|i18next }}</button>
    <button class="btn btn-primary" id="ladb_hardware_editor_btn_duplicate" style="display: none;">{{ 'core.hardware_editor.duplicate'|i18next }}</button>
    <button class="btn btn-primary" id="ladb_hardware_editor_btn_validate">{{ 'default.validate'|i18next }}</button>
{% endblock %}
