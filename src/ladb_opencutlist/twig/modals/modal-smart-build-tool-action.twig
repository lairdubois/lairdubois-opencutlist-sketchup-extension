{% extends 'core/_modal.twig' %}

{% set id = 'ladb_modal_'~modalName %}
{% set title = ('tool.smart_build.action_'~action)|i18next %}

{% block headerToolsInner %}
    {% include 'components/_widget-preset.twig' %}
    <button class="btn btn-default btn-xs" data-help-page="tool.smart-build"><i class="ladb-opencutlist-icon-help"></i> {{ 'default.help'|i18next }}</button>
{% endblock %}

{% block bodyInner %}
    <div class="tab-content">
        <div class="form form-horizontal" style="margin-top: 15px;">
            {% block formInner %}
                {% block optionConstruction %}
                    <div class="form-group">
                        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_options_construction_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_options_construction'|i18next }}</label>
                        <div class="col-xs-7">
                            <select class="form-control" id="ladb_select_construction">
                                <option value="0" data-content={{ 'default.no'|i18next }}></option>
                                <option value="1" data-content="{{ 'tool.smart_build.action_option_options_construction_status'|i18next }}"></option>
                            </select>
                        </div>
                    </div>
                {% endblock %}
                {% block optionOptionsMeasureReversed %}
                    <div class="form-group">
                        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_options_measure_reversed_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                        <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_options_measure_reversed'|i18next }}</label>
                        <div class="col-xs-7">
                            <select class="form-control" id="ladb_select_measure_reversed">
                                <option value="0" data-content="{{ 'default.no'|i18next }}"></option>
                                <option value="1" data-content="{{ 'tool.smart_build.action_option_options_measure_reversed_status'|i18next }}"></option>
                            </select>
                        </div>
                    </div>
                {% endblock %}
                {% block optionOptionsReduceEnvelope %}{% endblock %}
                <div class="form-group">
                    <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_build.action_option_options_ask_name_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                    <label class="control-label col-xs-4">{{ 'tool.smart_build.action_option_options_ask_name'|i18next }}</label>
                    <div class="col-xs-7">
                        <select class="form-control" id="ladb_select_ask_name">
                            <option value="0" data-content={{ 'default.automatic'|i18next }}></option>
                            <option value="1" data-content="{{ 'tool.smart_build.action_option_options_ask_name_status'|i18next }}"></option>
                        </select>
                    </div>
                </div>
            {% endblock %}
        </div>
    </div>
{% endblock %}

{% block footerRightInner %}
    <button class="btn btn-default" data-dismiss="modal">{{ 'default.cancel'|i18next }}</button>
    <button class="btn btn-primary btn-validate-modal" id="ladb_btn_validate">{{ 'default.validate'|i18next }}</button>
{% endblock %}
