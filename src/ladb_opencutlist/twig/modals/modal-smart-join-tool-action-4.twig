{% extends 'modals/modal-smart-join-tool-action.twig' %}

{% set hardware_name = 'hinge' %}

{% block optionHeight %}{% endblock %}

{% block geometriesInsetA %}
    <hr>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_hardware_hinge_inset_a_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_hardware_hinge_inset_a'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_hardware_inset_a">
        </div>
    </div>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_join.action_option_machining_inset_a_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_join.action_option_machining_inset_a'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_machining_inset_a">
        </div>
    </div>
{% endblock %}
