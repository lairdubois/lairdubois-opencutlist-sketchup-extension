{% extends 'core/_modal.twig' %}

{% set id = 'ladb_modal_'~modalName %}
{% set title = ('tool.smart_reshape.action_'~action)|i18next %}

{% block headerToolsInner %}
    {% include 'components/_widget-preset.twig' %}
    <button class="btn btn-default btn-xs" data-help-page="tool.smart-draw"><i class="ladb-opencutlist-icon-help"></i> {{ 'default.help'|i18next }}</button>
{% endblock %}

{% block bodyInner %}
    <div class="tab-content">
        <div class="form form-horizontal" style="margin-top: 15px;">
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_reshape.action_option_thickness_thickness_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_reshape.action_option_thickness_thickness'|i18next }}</label>
                <div class="col-xs-7">
                    <input type="text" class="form-control" id="ladb_input_thickness">
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_reshape.action_option_box_direction_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_reshape.action_option_group_box_direction'|i18next }}</label>
                <div class="col-xs-7">
                    <select class="form-control" id="ladb_select_box_direction">
                        <option value="inward" data-content="{{ 'tool.smart_reshape.action_option_box_direction_inward_status'|i18next }}"></option>
                        <option value="outward" data-content="{{ 'tool.smart_reshape.action_option_box_direction_outward_status'|i18next }}"></option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_reshape.action_option_box_joint_type_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
                <label class="control-label col-xs-4">{{ 'tool.smart_reshape.action_option_group_box_joint_type'|i18next }}</label>
                <div class="col-xs-7">
                    <select class="form-control" id="ladb_select_box_joint_type">
                        <option value="flat" data-content="{{ 'tool.smart_reshape.action_option_box_joint_type_flat_status'|i18next }}"></option>
                        <option value="miter" data-content="{{ 'tool.smart_reshape.action_option_box_joint_type_miter_status'|i18next }}"></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block footerRightInner %}
    <button class="btn btn-default" data-dismiss="modal">{{ 'default.cancel'|i18next }}</button>
    <button class="btn btn-primary btn-validate-modal" id="ladb_btn_validate">{{ 'default.validate'|i18next }}</button>
{% endblock %}