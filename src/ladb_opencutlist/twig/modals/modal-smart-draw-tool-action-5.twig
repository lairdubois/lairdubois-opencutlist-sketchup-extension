{% extends 'modals/modal-smart-draw-tool-action.twig' %}

{% block optionOffset %}{% endblock %}
{% block optionSegments %}{% endblock %}
{% block optionOptionsRectangleCentered %}{% endblock %}
{% block optionOptionsSmoothing %}{% endblock %}
{% block optionOptionsMeasureFromDiameter %}{% endblock %}
{% block optionOptionsOptionsPullCentred %}{% endblock %}
{% block optionOptionsOptionsDrawIn %}{% endblock %}

{% block optionOptionsReduceEnvelope %}
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_draw.action_option_options_reduce_envelope_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_options_reduce_envelope'|i18next }}</label>
        <div class="col-xs-7">
            <select class="form-control" id="ladb_select_reduce_envelope">
                <option value="0" data-content="{{ 'default.no'|i18next }}"></option>
                <option value="1" data-content="{{ 'tool.smart_draw.action_option_options_reduce_envelope_status'|i18next }}"></option>
            </select>
        </div>
    </div>
{% endblock %}

{% block formInner %}
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_draw.action_option_thickness_thickness_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_group_thickness'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_thickness">
        </div>
    </div>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_draw.action_option_offset_back_panel_depth_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_offset_back_panel_depth'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_back_panel_depth">
        </div>
    </div>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_draw.action_option_offset_back_panel_setback_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_offset_back_panel_setback'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_back_panel_setback">
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_group_axes'|i18next }}</label>
        <div class="col-xs-7">
            <select class="form-control" id="ladb_select_axes">
                <option value="active" data-content="{{ 'tool.smart_draw.action_option_axes_active_status'|i18next }}"></option>
                <option value="context" data-content="{{ 'tool.smart_draw.action_option_axes_context_status'|i18next }}"></option>
            </select>
        </div>
    </div>
    {{ parent() }}
    <hr>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_draw.action_option_options_layer_name_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_options_layer_name'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_layer_name">
        </div>
    </div>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_draw.action_option_options_machining_material_name_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_options_machining_material_name'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_machining_material_name">
        </div>
    </div>
    <div class="form-group">
        <div class="ladb-minitools ladb-minitools-right ladb-minitools-lgw"><a tabindex="-1" data-toggle="popover" data-trigger="hover" data-placement="left" title="{{ 'default.help'|i18next }}" data-content="{{ 'tool.smart_draw.action_option_options_machining_layer_name_status'|i18next }}"><i class="ladb-opencutlist-icon-help"></i></a></div>
        <label class="control-label col-xs-4">{{ 'tool.smart_draw.action_option_options_machining_layer_name'|i18next }}</label>
        <div class="col-xs-7">
            <input type="text" class="form-control" id="ladb_input_machining_layer_name">
        </div>
    </div>
{% endblock %}
